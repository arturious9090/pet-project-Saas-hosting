// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String     @id @default(cuid())
  email    String     @unique
  password String
  status   UserStatus @default(PANDING)
  role     UserRole   @default(USER)
  sessions Session[]
  userName String     @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Session {
  id        String        @id @default(cuid())
  userId    String
  status    SessionStatus
  ip        String?
  ua        String?
  sessionId String        @unique
  createdAt DateTime      @default(now())
  expiresAt DateTime
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id      String        @id @default(cuid())
  name    String
  status  ProjectStatus
  ownerId String
  owner   User          @relation(fields: [ownerId], references: [id])
  files   File[]
  domain  Domain?
}

model File {
  id         String         @id @default(cuid())
  name       String
  storedName String?        @unique
  ownerId    String
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id])
  mimeType   MimeType?
  path       String // path to a file in web 
  key        String // Key to a file in S3 storage 
  size       Int?
  hashSum    String?
  extension  FileExtension?
  status     FileStatus
  metaData   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Domain {
  id String @id @default(cuid())

  rootDomain  String
  subdomain   String? // null/'' = apex
  fqdn        String  @unique
  ipv6        String?
  proxied     Boolean @default(true)
  zoneId      String
  cfRecordIds Json // {A?: string, AAAA?: string, CNAME?: string}
  projectId   String  @unique
  project     Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Отдельная модель баланса 

enum UserRole {
  USER
  ADMIN
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum UserStatus {
  PANDING
  VERIFIED
  BANNED
}

enum ProjectStatus {
  ACTIVE
  DRAFT
  DELETED
  ARCHIVED
}

enum FileStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  REJECTED
}

enum MimeType {
  // Документы
  APPLICATION_PDF
  APPLICATION_JSON
  APPLICATION_XML
  APPLICATION_ZIP
  APPLICATION_OCTET_STREAM
  TEXT_PLAIN
  TEXT_HTML
  TEXT_CSS
  TEXT_JAVASCRIPT

  // Изображения
  IMAGE_JPEG
  IMAGE_PNG
  IMAGE_GIF
  IMAGE_WEBP
  IMAGE_SVG_XML
  IMAGE_BMP
  IMAGE_TIFF

  // Видео
  VIDEO_MP4
  VIDEO_WEBM
  VIDEO_OGG
  VIDEO_QUICKTIME
  VIDEO_X_MSVIDEO

  // Аудио
  AUDIO_MPEG
  AUDIO_WAV
  AUDIO_OGG
  AUDIO_WEBM

  // Другие
  MULTIPART_FORM_DATA
}

enum FileExtension {
  // Изображения
  JPG
  JPEG
  PNG
  GIF
  SVG
  WEBP
  TIFF
  BMP
  HEIC

  // Документы и текст
  PDF
  TXT
  DOC
  DOCX
  RTF
  ODT

  // Таблицы
  XLS
  XLSX
  CSV
  ODS

  // Презентации
  PPT
  PPTX
  ODP

  // Архивы
  ZIP
  RAR
  TAR
  GZ

  // Аудио
  MP3
  WAV
  FLAC
  AAC
  OGG

  // Видео
  MP4
  AVI
  MKV
  MOV
  WMV
  FLV

  // Исходный код и данные
  JS
  TS
  JSON
  XML
  HTML
  CSS
  MD
  YAML
  YML
  SQL
  SH
  PY
  RB
  PHP
  JAVA
  C
  CPP
  CS
  GO
  RS

  // Исполняемые и системные файлы
  EXE
  BAT
  BIN
  DLL
  ISO
  DMG
  APK
}
